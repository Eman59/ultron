# Ultron Core Agent — Multi-stage build
FROM golang:1.21-alpine AS builder

WORKDIR /app
COPY go/core_agent/ .

RUN apk add --no-cache git
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /ultron-core-agent .

# Runtime
FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /ultron-core-agent /usr/local/bin/ultron-core-agent

EXPOSE 50051 8080
ENTRYPOINT ["/usr/local/bin/ultron-core-agent"]
